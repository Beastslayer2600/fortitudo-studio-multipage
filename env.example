# ── Resend (contact form emails) ────────────────────────────────────
# Sign up at https://resend.com and create an API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The address form submissions are delivered to (must be verified in Resend)
CONTACT_EMAIL=your-email@example.com

# The "from" address shown in sent emails (must be from a verified domain in Resend)
# For testing you can use: onboarding@resend.dev
FROM_EMAIL=website@yourdomain.com
